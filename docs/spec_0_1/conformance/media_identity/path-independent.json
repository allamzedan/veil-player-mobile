{
  "vectorFormatVersion": "0.1",
  "id": "media_identity.path-independent",
  "category": "media_identity",
  "specVersion": "0.1",
  "serializationProfile": "1.6.0",
  "description": "Filesystem path does not participate in metadata-v1 identity.",
  "appliesTo": [
    "media_identity"
  ],
  "input": {
    "timelineIdentity": {
      "name": "sample.mp4",
      "duration": 120.0,
      "fileSize": 1000000,
      "resolution": {
        "width": 1920,
        "height": 1080
      },
      "fingerprint": {
        "method": "metadata-v1",
        "value": "sample.mp4|1000000|120.000|1920|1080"
      }
    },
    "loadedMediaIdentity": {
      "name": "sample.mp4",
      "duration": 120.0,
      "fileSize": 1000000,
      "resolution": {
        "width": 1920,
        "height": 1080
      },
      "fingerprint": {
        "method": "metadata-v1",
        "value": "sample.mp4|1000000|120.000|1920|1080"
      }
    },
    "timelinePath": "C:/A/sample.mp4",
    "loadedPath": "D:/B/sample.mp4"
  },
  "expected": {
    "desktopRawMatchingResult": {
      "pathParticipates": false
    },
    "identityStatus": "MATCH"
  }
}
