{
  "vectorFormatVersion": "0.1",
  "id": "media_identity.fingerprint-mismatch",
  "category": "media_identity",
  "specVersion": "0.1",
  "serializationProfile": "1.6.0",
  "description": "Explicit metadata-v1 value contradicts.",
  "appliesTo": [
    "media_identity"
  ],
  "input": {
    "timelineIdentity": {
      "name": "sample.mp4",
      "duration": 120.0,
      "fileSize": 1000000,
      "resolution": {
        "width": 1920,
        "height": 1080
      },
      "fingerprint": {
        "method": "metadata-v1",
        "value": "sample.mp4|1000000|120.000|1920|1080"
      }
    },
    "loadedMediaIdentity": {
      "name": "sample.mp4",
      "duration": 120.0,
      "fileSize": 1000000,
      "resolution": {
        "width": 1920,
        "height": 1080
      },
      "fingerprint": {
        "method": "metadata-v1",
        "value": "different"
      }
    }
  },
  "expected": {
    "desktopRawMatchingResult": {
      "nameMismatch": false,
      "fileSizeMismatch": false,
      "durationMismatch": false,
      "resolutionMismatch": false,
      "fingerprintMismatch": true
    },
    "identityStatus": "MISMATCH"
  }
}
